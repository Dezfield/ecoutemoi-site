# VITE_* values are embedded in the browser bundle.
# NEVER place a service_role key here — only the publishable (anon) key.

# Supabase project credentials
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# App URLs
VITE_APP_URL=https://app.ecoutemoi.ru
VITE_PUBLIC_SITE_URL=https://ecoutemoi.ru

# Legal pages (used for links in auth UI)
VITE_TERMS_URL=https://ecoutemoi.ru/terms/
VITE_PRIVACY_URL=https://ecoutemoi.ru/privacy/
