# Copy to app/.env.local for development (never commit real values).
# Every VITE_* value is embedded in the public browser bundle.
# NEVER place a service_role key, OAuth client secret, Apple private key or
# VK secret here — only the Supabase project URL and publishable (anon) key.

# The Supabase project used by the mobile app (ecoutemoi-mobile/.env.example:
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Public marketing site used for legal/support links (no trailing slash).
VITE_PUBLIC_SITE_URL=https://ecoutemoi.ru

# Optional overrides; by default ${VITE_PUBLIC_SITE_URL}/terms/ and /privacy/.
# VITE_TERMS_URL=https://ecoutemoi.ru/terms/
# VITE_PRIVACY_URL=https://ecoutemoi.ru/privacy/

# Web registration. Only the literal value `true` enables it; anything else
# keeps it off. RELEASE BLOCKER: keep `false` for public production until the
# Terms and Privacy Policy are approved and published, the 18+ consent flow is
# product-approved and signup is tested against the real Supabase project
# (docs/WEB_APP_DEPLOYMENT.md, section 6).
VITE_AUTH_SIGNUP_ENABLED=false

# OAuth providers for the web sign-in screen. Supported: apple, google.
# A first OAuth sign-in creates a new Supabase user, so providers are shown
# only when VITE_AUTH_SIGNUP_ENABLED=true. VK is not available on the web.
VITE_AUTH_OAUTH_PROVIDERS=

# Auth redirects are built from the current origin: https://<app-origin>/auth/callback
# must be in the Supabase Auth redirect allowlist for every origin serving the app.
