{
  "name": "ecoutemoi-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --import tsx --test tests/unit/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
