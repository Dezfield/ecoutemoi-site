{
  "name": "ecoutemoi-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "npm run typecheck && vite build && tsx scripts/prerender.tsx",
    "build:production": "npm run typecheck && vite build --mode production && tsx scripts/prerender.tsx --production",
    "preview": "node scripts/serve.mjs",
    "check": "npm run lint && npm run build && node scripts/check.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
